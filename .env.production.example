# Image settings for docker-compose.prod.yml
BACKEND_IMAGE=ghcr.io/tenon-nonet/juku-management-backend
FRONTEND_IMAGE=ghcr.io/tenon-nonet/juku-management-frontend
IMAGE_TAG=release

# Application settings
DB_NAME=juku
DB_USER=juku_user
DB_PASSWORD=<set-a-strong-password>
JWT_SECRET=<set-a-long-random-secret>
